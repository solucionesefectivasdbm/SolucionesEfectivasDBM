# URL base del backend API.
#
# Dejar VACÍO (o no definir) para entornos Vercel (producción y preview):
# el rewrite en vercel.json enruta /api/* al backend de Railway como same-origin,
# lo que garantiza cookies first-party en Safari y Chrome.
#
# Para desarrollo local, dejar también vacío: el proxy de Vite (vite.config.ts)
# reenvía /api → http://localhost:8000 automáticamente.
#
# Solo asignar una URL absoluta si se hace testing local DIRECTO contra Railway
# sin pasar por el proxy de Vite (caso excepcional).
VITE_API_URL=
